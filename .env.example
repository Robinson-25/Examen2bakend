# Copia este archivo como ".env" y pega los datos de tu add-on MySQL de Clever Cloud
# (Console > bd_farmacia > Information / Environment variables)
PORT=8080

MYSQL_ADDON_HOST=xxxxxxxx-mysql.services.clever-cloud.com
MYSQL_ADDON_PORT=3306
MYSQL_ADDON_DB=xxxxxxxx
MYSQL_ADDON_USER=xxxxxxxx
MYSQL_ADDON_PASSWORD=xxxxxxxx

# Clave para firmar los JWT (cámbiala por un texto largo y secreto)
JWT_SECRET=cambia-esta-clave-super-secreta
JWT_EXPIRES_IN=1d

# URL del frontend permitido por CORS (en local: http://localhost:5173)
CORS_ORIGIN=http://localhost:5173
